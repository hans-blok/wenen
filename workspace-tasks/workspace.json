{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "md-to-dbml",
      "type": "shell",
      "command": "python scripts/md_to_dbml.py"
    },
    {
      "label": "md-to-graphml",
      "type": "shell",
      "command": "python scripts/ldm_to_graphml.py"
    },
    {
      "label": "git-commit-push",
      "type": "shell",
      "command": "git add . && git commit -m \"${input:commitMessage}\" && git push"
    },
    {
      "label": "fetch-ecosystem-coordinator",
      "type": "shell",
      "command": "python scripts/fetch_ecosystem_coordinator.py"
    }
  ],
  "inputs": [
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Enter commit message"
    }
  ]
}
